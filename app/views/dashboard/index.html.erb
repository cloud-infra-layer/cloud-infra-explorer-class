<% content_for :title, "Overview | Cloud Infrastructure Explorer" %>

<% if flash[:notice].present? %>
  <p role="status"><%= flash[:notice] %></p>
<% end %>
<% if flash[:alert].present? %>
  <p role="alert"><%= flash[:alert] %></p>
<% end %>

<% if @connected_environment %>
  <section class="connected-account-card" aria-label="Selected environment">
    <div class="account-details">
      <span class="account-label">ENVIRONMENT</span>

      <h2><%= @connected_environment.name %></h2>

      <p class="account-region">
        <%= provider_label(@connected_environment.provider) %> · <%= @connected_environment.region %>
      </p>

      <% if @scan_enabled %>
        <%= render "scan_controls", environment: @connected_environment, environments: @scan_environments %>
        <%= render "scan_result", scan: @latest_scan %>
      <% end %>
    </div>

    <div class="account-update">
      <span class="update-label">● Last successful scan</span>

      <% if @last_successful_scan %>
        <%= time_tag @last_successful_scan.completed_at,
          @last_successful_scan.completed_at.in_time_zone.strftime("%b %-d, %Y at %-I:%M %p") %>
      <% else %>
        <span>—</span>
      <% end %>
    </div>
  </section>
<% elsif @scan_enabled %>
  <section class="connected-account-card" aria-label="Selected environment">
    <p class="empty-state">No environments are configured.</p>
  </section>
<% end %>

<% if @cost_insights %>
  <section class="cost-insights" aria-label="Cost insights">
    <p class="cost-insights-period"><%= @cost_insights[:period_label] %></p>
    <div class="dashboard-stats">
      <div class="stat-card">
        <span class="stat-label">Monthly spend</span>
        <div class="stat-value">
          <span>$<%= number_with_precision(@cost_insights[:current_total], precision: 2) %></span>
        </div>
        <div class="stat-deltas">
          <span class="stat-delta">
            <span class="stat-delta-label">MoM</span>
            <%= render "trend_value", value: @cost_insights[:mom_pct] %>
          </span>
          <span class="stat-delta">
            <span class="stat-delta-label">YoY</span>
            <%= render "trend_value", value: @cost_insights[:yoy_pct] %>
          </span>
        </div>
      </div>

      <div class="stat-card">
        <span class="stat-label">Top cost driver</span>
        <div class="stat-value stat-value--compact">
          <span><%= cost_series_legend_label(@cost_insights[:top_service], provider: @cost_insights[:top_provider]) %></span>
        </div>
        <div class="stat-deltas">
          <span class="stat-delta">
            $<%= number_with_precision(@cost_insights[:top_amount], precision: 2) %>
          </span>
          <% if @cost_insights[:top_share] %>
            <span class="stat-delta">
              <%= number_with_precision(@cost_insights[:top_share], precision: 0) %>% of spend
            </span>
          <% end %>
        </div>
      </div>

      <div class="stat-card">
        <span class="stat-label">Fastest growing</span>
        <% if @cost_insights[:fastest_service] %>
          <div class="stat-value stat-value--compact">
            <span><%= cost_series_legend_label(@cost_insights[:fastest_service], provider: @cost_insights[:fastest_provider]) %></span>
          </div>
          <div class="stat-deltas">
            <span class="stat-delta">
              <%= render "trend_value", value: @cost_insights[:fastest_pct] %>
            </span>
            <span class="stat-delta">
              $<%= number_with_precision(@cost_insights[:fastest_amount], precision: 2) %>
            </span>
          </div>
        <% else %>
          <div class="stat-value"><span>—</span></div>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<% if @cost_chart[:periods].any? %>
  <section class="content-panel cost-panel" aria-labelledby="cost-overview-heading">
    <h2 id="cost-overview-heading">Cost Explorer</h2>
    <%= render "cost_chart", cost_chart: @cost_chart %>
  </section>
<% end %>

<div class="category-grid">
  <% Resource::CATEGORIES.each do |key, config| %>
    <% insight = @category_insights.fetch(key) %>
    <%= render "home/category_card",
        path: resources_path(category: key),
        category_key: key,
        name: config.fetch(:label),
        description: config.fetch(:description),
        count: insight.fetch(:count),
        pinned: insight.fetch(:pinned),
        insight: insight.fetch(:insight) %>
  <% end %>
</div>
