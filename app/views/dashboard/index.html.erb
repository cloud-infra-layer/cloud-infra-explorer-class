
<% content_for :title, "Dashboard | Cloud Infrastructure Explorer" %>

<header>
  <h1>Cloud Infrastructure Explorer</h1>
</header>

<% if flash[:notice].present? %>
  <p role="status"><%= flash[:notice] %></p>
<% end %>
<% if flash[:alert].present? %>
  <p role="alert"><%= flash[:alert] %></p>
<% end %>


<% if @connected_environment %>
  <section class="connected-account-card" aria-label="Connected AWS account">
    <div class="account-details">
      <span class="account-label">CONNECTED ACCOUNT</span>

      <h2><%= @connected_environment.name %></h2>

      <p class="account-region">
        AWS · <%= @connected_environment.region %>
      </p>

      <% if @scan_enabled %>
        <%= form_with url: environment_scans_path(@connected_environment), method: :post do %>
          <%= hidden_field_tag "resource_types[]", "ec2" %>
          <%= hidden_field_tag "resource_types[]", "s3" %>
          <%= submit_tag "Refresh resources", class: "refresh-button" %>
        <% end %>
      <% end %>
    </div>

    <div class="account-update">
      <span class="update-label">● Last updated</span>

      <% if @last_successful_scan %>
        <%= time_tag @last_successful_scan.completed_at,
          @last_successful_scan.completed_at.in_time_zone.strftime("%b %-d, %Y at %-I:%M %p") %>
      <% else %>
        <span>No successful scans yet</span>
      <% end %>
    </div>
  </section>
<% end %>

<div class="category-grid">
  <%= render "home/category_card",
      service: "ec2",
      name: "EC2 Instances",
      count: @resource_counts.fetch("ec2", 0) %>

  <%= render "home/category_card",
      service: "s3",
      name: "S3 Buckets",
      count: @resource_counts.fetch("s3", 0) %>
</div>

