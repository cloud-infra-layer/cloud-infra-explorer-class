<%= link_to path, class: "content-panel category-card" do %>
  <div class="category-card-header">
    <span class="category-icon" aria-hidden="true"><%= category_icon(category_key) %></span>
    <h2><%= name %></h2>
  </div>
  <p class="resource-count"><%= pluralize(count, "resource") %></p>
  <p class="category-insight"><%= insight %></p>
  <% if count.positive? %>
    <p class="category-description"><%= description %></p>
    <% if pinned.positive? %>
      <p class="category-meta category-pinned"><%= pinned %> Pinned</p>
    <% end %>
  <% end %>
  <span class="category-action">View <%= name %> <span aria-hidden="true">&rarr;</span></span>
<% end %>
