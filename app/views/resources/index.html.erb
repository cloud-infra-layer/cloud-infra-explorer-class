<% content_for :title, "#{@page_title} | Cloud Infrastructure Explorer" %>
<h1><%= @page_title %></h1>
<p class="page-description">Browse your stored cloud inventory.</p>
<section class="content-panel" aria-labelledby="resources-heading">
  <h2 id="resources-heading">Stored inventory</h2>
  <% if @resources.empty? %>
    <p class="empty-state">No <%= "#{params[:service].upcase} " if params[:service].present? %>resources found.</p>
  <% else %>
    <%= render "table", resources: @resources, caption: @page_title %>
  <% end %>
  <%= link_to "Back to dashboard", root_path %>
</section>
