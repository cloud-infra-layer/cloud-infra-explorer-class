
<% content_for :title, "Dashboard | Cloud Infrastructure Explorer" %>

<header>
  <h1>Cloud Infrastructure Explorer</h1>
  <p class="page-description">
    Stored AWS resources across all environments. Scans run only when explicitly requested by an authorized administrator.
  </p>

  <nav aria-label="Resource categories">
    <%= link_to "EC2 instances", "#ec2-resources" %>
    <%= link_to "S3 buckets", "#s3-resources" %>
  </nav>
</header>

<% if flash[:notice].present? %>
  <p role="status"><%= flash[:notice] %></p>
<% end %>
<% if flash[:alert].present? %>
  <p role="alert"><%= flash[:alert] %></p>
<% end %>

<% if @scan_enabled %>
  <section aria-labelledby="scan-heading">
    <h2 id="scan-heading">Manual AWS discovery</h2>
    <p>Scanning uses the application's configured read-only AWS credentials.</p>
    <% @environments.each do |environment| %>
      <%= form_with url: environment_scans_path(environment), method: :post do %>
        <p><%= environment.name %> (<%= environment.region %>)</p>
        <%= hidden_field_tag "resource_types[]", "ec2" %>
        <%= hidden_field_tag "resource_types[]", "s3" %>
        <%= submit_tag "Scan EC2 and S3" %>
      <% end %>
    <% end %>
  </section>
<% end %>

<div class="category-grid">
  <%= render "home/category_card",
      service: "ec2",
      name: "EC2 Instances",
      count: @resource_counts.fetch("ec2", 0) %>

  <%= render "home/category_card",
      service: "s3",
      name: "S3 Buckets",
      count: @resource_counts.fetch("s3", 0) %>
</div>

<% { "ec2" => "EC2 instances", "s3" => "S3 buckets" }.each do |service, label| %>
  <section id="<%= service %>-resources" aria-labelledby="<%= service %>-heading">
    <h2 id="<%= service %>-heading"><%= label %></h2>

    <p class="resource-count">
      <%= pluralize(@resource_counts.fetch(service), "resource") %>
    </p>

    <% if @resources_by_service.fetch(service).empty? %>
      <p class="empty-state">No <%= label %> stored yet.</p>
    <% else %>
      <table>
        <caption><%= label %> across all environments</caption>
        <thead>
          <tr>
            <th scope="col">Name</th>
            <th scope="col">Environment</th>
            <th scope="col">Region</th>
            <th scope="col">Resource ID</th>
          </tr>
        </thead>

        <tbody>
          <% @resources_by_service.fetch(service).each do |resource| %>
            <tr id="resource-<%= resource.id %>">
              <td><%= resource.name %></td>
              <td><%= resource.environment.name %></td>
              <td><%= resource.region.presence || "Not specified" %></td>
              <td><%= resource.resource_id %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </section>
<% end %>
