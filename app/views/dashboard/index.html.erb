
<% content_for :title, "Dashboard | Cloud Infrastructure Explorer" %>

<header>
  <h1>Cloud Infrastructure Explorer</h1>
</header>

<% if flash[:notice].present? %>
  <p role="status"><%= flash[:notice] %></p>
<% end %>
<% if flash[:alert].present? %>
  <p role="alert"><%= flash[:alert] %></p>
<% end %>


<% if @connected_environment %>
  <section class="connected-account-card" aria-label="Connected AWS account">
    <div class="account-details">
      <span class="account-label">CONNECTED ACCOUNT</span>

      <h2><%= @connected_environment.name %></h2>

      <p class="account-region">
        AWS · <%= @connected_environment.region %>
      </p>

      <% if @scan_enabled %>
        <%= render "scan_controls", environment: @connected_environment, environments: @scan_environments %>
        <%= render "scan_result", scan: @latest_scan %>
      <% end %>
    </div>

    <div class="account-update">
      <span class="update-label">● Last updated</span>

      <% if @last_successful_scan %>
        <%= time_tag @last_successful_scan.completed_at,
          @last_successful_scan.completed_at.in_time_zone.strftime("%b %-d, %Y at %-I:%M %p") %>
      <% else %>
        <span>No successful scans yet</span>
      <% end %>
    </div>
  </section>
<% elsif @scan_enabled %>
  <section class="connected-account-card" aria-label="Connected AWS account">
    <p class="empty-state">No AWS environments are configured.</p>
  </section>
<% end %>

<section class="dashboard-stats" aria-label="Infrastructure overview">
  <div class="stat-card">
    <span class="stat-label">Active Services</span>
    <div class="stat-value">
      <span><%= @dashboard_stats[:active_services] %></span>
      <small>/240+</small>
    </div>
  </div>

  <div class="stat-card">
    <span class="stat-label">Total Resources</span>
    <div class="stat-value">
      <span><%= @dashboard_stats[:total_resources] %></span>
    </div>
  </div>

  <div class="stat-card">
    <%= link_to "Pinned", resources_path(pinned: "1"), class: "stat-label" %>
    <div class="stat-value">
      <span><%= @dashboard_stats[:pinned] %></span>
      <small>/<%= @dashboard_stats[:total_resources] %></small>
    </div>
  </div>

  <div class="stat-card">
    <span class="stat-label">Needs Attention</span>
    <div class="stat-value">
      <span>—</span>
      <small>/<%= @dashboard_stats[:total_resources] %></small>
    </div>
  </div>
</section>

<p class="empty-state">Inventory counts include visible resources only. <%= link_to "View hidden resources", resources_path(visibility: "hidden") %></p>

<div class="category-grid">
  <%= render "home/category_card",
      service: "ec2",
      name: "EC2 Instances",
      count: @resource_counts.fetch("ec2", 0) %>

  <%= render "home/category_card",
      service: "s3",
      name: "S3 Buckets",
      count: @resource_counts.fetch("s3", 0) %>
</div>

