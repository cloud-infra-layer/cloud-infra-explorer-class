<% content_for :title, "#{@page_title} | Cloud Infrastructure Explorer" %>
<% if flash[:notice].present? %>
  <p class="inventory-notice" role="status"><%= flash[:notice] %></p>
<% end %>
<% unless @personalization_enabled %>
  <p class="empty-state">Pinning, hiding, and restoring are currently unavailable.</p>
<% end %>

<nav class="inventory-categories" aria-label="Category filters">
  <% Resource::CATEGORIES.each do |key, config| %>
    <% selected = !@category_filter_active || @selected_categories.include?(key) %>
    <% next_categories = if !@category_filter_active
         [ key ]
       elsif @selected_categories.include?(key)
         @selected_categories - [ key ]
       else
         @selected_categories + [ key ]
       end %>
    <% path_filters = @listing_filters.except(:category, :categories) %>
    <% href = if next_categories.empty? || next_categories.size == Resource::CATEGORIES.size
         resources_path(path_filters)
       elsif next_categories.size == 1
         resources_path(path_filters.merge(category: next_categories.first))
       else
         resources_path(path_filters.merge(categories: next_categories))
       end %>
    <%= link_to config.fetch(:label), href,
          class: [ "inventory-category", ("is-active" if selected) ],
          aria: { pressed: selected } %>
  <% end %>
</nav>

<%= form_with url: resources_path, method: :get, class: "inventory-search" do |form| %>
  <% if @category_filter_active %>
    <% if @selected_categories.size == 1 %>
      <%= form.hidden_field :category, value: @selected_categories.first %>
    <% else %>
      <% @selected_categories.each do |category| %>
        <%= hidden_field_tag "categories[]", category %>
      <% end %>
    <% end %>
  <% end %>
  <div>
    <%= form.label :q, "Search resources" %>
    <%= form.search_field :q, value: @query, placeholder: "Name, service, or resource ID" %>
  </div>
  <%= form.submit "Search", class: "inventory-button" %>
  <% if @query.present? %>
    <%= link_to "Clear search", resources_path(@listing_filters.except(:q)) %>
  <% end %>
<% end %>

<section class="content-panel" aria-label="Resource inventory">
  <% if @resources.empty? %>
    <p class="empty-state">No resources match the current filters.</p>
  <% else %>
    <%= render "table", resources: @resources,
        personalization_enabled: @personalization_enabled, listing_filters: @listing_filters %>
  <% end %>
  <%= link_to "Back to overview", root_path %>
</section>
