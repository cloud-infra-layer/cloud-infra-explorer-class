<% content_for :title, "Overview | Cloud Infrastructure Explorer" %>
<div class="category-grid">
  <% Resource::CATEGORIES.each do |key, config| %>
    <% count = @resource_counts.fetch_values(*config.fetch(:services)) { 0 }.sum %>
    <%= render "category_card",
        path: resources_path(category: key),
        category_key: key,
        name: config.fetch(:label),
        description: config.fetch(:description),
        count: count,
        pinned: 0,
        insight: (count.zero? ? "No stored resources yet." : config.fetch(:description)) %>
  <% end %>
</div>
