
<header class="site-header">
  <div class="navigation-container">
    <%= link_to "Cloud Infrastructure Explorer", root_path, class: "brand" %>

    <nav class="primary-navigation" aria-label="Primary navigation">
      <%= link_to "Overview",
          root_path,
          aria: {
            current: %w[home dashboard].include?(controller_name) ? "page" : nil
          } %>

      <%= link_to "Compute",
          resources_path(service: "ec2"),
          aria: {
            current: controller_name == "resources" && params[:service] == "ec2" ? "page" : nil
          } %>

      <%= link_to "Storage",
          resources_path(service: "s3"),
          aria: {
            current: controller_name == "resources" && params[:service] == "s3" ? "page" : nil
          } %>

      <%= link_to "Pinned",
          resources_path(pinned: "1"),
          aria: {
            current: controller_name == "resources" && params[:pinned] == "1" && params[:service].blank? ? "page" : nil
          } %>
    </nav>
  </div>
</header>
