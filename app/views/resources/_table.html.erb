<div class="resource-table-scroll" role="region" aria-label="Resource inventory table" tabindex="0">
  <table class="resource-table">
    <caption><%= caption %> — stored inventory across all environments</caption>
    <thead>
      <tr>
        <th scope="col">Resource name</th>
        <th scope="col">Service</th>
        <th scope="col">Region</th>
        <th scope="col">Resource ID</th>
        <th scope="col">Metadata</th>
        <th scope="col">Status</th>
        <% if personalization_enabled %>
          <th scope="col">Actions</th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% resources.each do |resource| %>
        <tr>
          <th scope="row"><%= resource.name %></th>
          <td><%= resource.service.upcase %></td>
          <td><%= resource.region.presence || "Unknown" %></td>
          <td class="resource-identifier"><%= resource.resource_id %></td>
          <td><%= resource_metadata(resource) %></td>
          <td><%= resource.hidden? ? "Hidden" : (resource.pinned? ? "Pinned" : "Unpinned") %></td>
          <% if personalization_enabled %>
            <td>
              <div class="resource-actions">
                <% actions = if resource.hidden?
                  { "Restore" => restore_resource_path(resource) }
                else
                  pin_action = resource.pinned? ? { "Unpin" => unpin_resource_path(resource) } : { "Pin" => pin_resource_path(resource) }
                  pin_action.merge("Hide" => hide_resource_path(resource))
                end %>
                <% actions.each do |label, path| %>
                  <%= button_to label, path, method: :patch, params: listing_filters,
                      class: "inventory-button", form: { data: { turbo: false } },
                      aria: { label: "#{label} #{resource.name} (#{resource.resource_id})" } %>
                <% end %>
              </div>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
